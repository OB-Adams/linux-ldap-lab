; 389-ds instance definition. Copy to lab.inf, set a real password, chmod 600.
; Create with: sudo dscreate from-file lab.inf
[general]
full_machine_name = ldap.lab.local
selinux = True

[slapd]
instance_name = lab
root_dn = cn=Directory Manager
root_password = CHANGE_ME
port = 389
secure_port = 636
self_sign_cert = True

; This section header must be present and uncommented. If it is not,
; dscreate still succeeds but builds an instance with NO backend
; (see docs/troubleshooting.md).
[backend-userroot]
create_suffix_entry = True
suffix = dc=lab,dc=local
sample_entries = no
